doctype html
html( lang="ca" itemtype="https://schema.org/Person" itemscope )
  head
    meta( charset="UTF-8" )
    title Andrey Sitnik
    meta( name="description" content="Contactes i projectes d’Andrey Sitnik" )
    include ../base/head.pug
  body
    .layout
      .layout_globe

        a.photo( href="../photo/andreysitnik.jpg" target="_blank" )
          picture.photo_image
            source( srcset="../photo/photo.avif" type="image/avif" )
            img.photo_image( src="../photo/photo.jpg" alt="Foto d’Andrey Sitnik" itemprop="image" )

        h1.layout_title
          span( itemprop="givenName" ) Andrey
          = ' '
          span( itemprop="familyName" ) Sitnik

        .globe
          .earth( data-lat=location.latitude data-lng=location.longitude )
            .earth_loading
            canvas.earth_canvas

          .globe_visited
            = visited.countries.length
            = ' '
            = pluralize(visited.countries.length, 'país visitat', 'països visitats')

          button.globe_location( type="button" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress" tabindex="-1" )
            span( itemprop="addressLocality" )= location.ca.city
            = ', '
            span( itemprop="addressCountry" )= location.ca.country

      .layout_links

        .contacts
          .contacts_item
            a.link( href="mailto:andrey@sitnik.es" itemprop="email" )
              | andrey@sitnik.es
            .contacts_notes
              a.link( href="https://keybase.io/iskin" itemprop="sameAs" rel="me" title="Clau pública GnuPG per verificar la meva signatura o xifrar missatges per a mi" )
                | PGP 73A1 B5BE 55B9 003D
          .contacts_item
            a.link.is-text( href="tel:+34613026399" itemprop="telephone" )
              | +34 613 026 399
            .contacts_notes
              a.link( href="https://wa.me/qr/K6NQVJHY25WKG1" itemprop="sameAs" rel="me" )
                | WhatsApp
              = ' '
              a.link( href="https://t.me/sitnik" itemprop="sameAs" rel="me" )
                | Telegram

        link( href="https://bsky.app/profile/sitnik.bsky.social" itemprop="sameAs" rel="me" )
        link( href="https://twitter.com/andrey_sitnik" itemprop="sameAs" rel="me" )
        link( href="https://vk.com/iskin" itemprop="sameAs" rel="me" )
        link( href="https://mastodon.social/@sitnik_ru" itemprop="sameAs" rel="me" )
        link( href="https://mastodon.social/@sitnik" itemprop="sameAs" rel="me" )
        link( href="https://bsky.app/profile/ru.sitnik.es" itemprop="sameAs" rel="me" )

        ul.projects
          li.projects_item
            h2.projects_title
              span.projects_name Xarxes socials
              ul.projects_links
                li.projects_link
                  a.link( href="https://mastodon.social/@sitnik_en" itemprop="sameAs" rel="me" )
                    | Mastodon
                li.projects_link
                  a.link( href="https://bsky.app/profile/en.sitnik.es" itemprop="sameAs" rel="me" )
                    | Bluesky
                li.projects_link
                  a.link( href="https://twitter.com/andreysitnik" itemprop="sameAs" rel="me" )
                    | Twitter
            p
              | Les meves notes

          li.projects_item
            h2.projects_title
              a.link( href="https://github.com/ai" itemprop="sameAs" rel="me" )
                | GitHub
            p
              | He creat Autoprefixer, PostCSS, Browserslist, Nano ID i Nano Stores

          li.projects_item
            h2.projects_title
              a.link( href="https://slowreader.app/" )
                | Slow Reader
            p
              | Un coach que t’ajuda a llegir contingut més reflexiu dels teus feeds

          li.projects_item
            h2.projects_title
              span.projects_name Sitnikfriday
              ul.projects_links
                li.projects_link
                  a.link( href="https://bsky.app/profile/friday.sitnik.es" itemprop="sameAs" rel="me" )
                    | Bluesky
                li.projects_link
                  a.link( href="https://mastodon.social/@sitnikfriday" itemprop="sameAs" rel="me" )
                    | Mastodon
                li.projects_link
                  a.link( href="https://t.me/sitnikfriday" itemprop="sameAs" rel="me" )
                    | Telegram
            p
              | El meu projecte sexpositiu

      .layout_language
        a.link( href="/en/" hreflang="en" rel="alternate" ) English
        span.layout_separator= ' '
        a.link( href="/es/" hreflang="es" rel="alternate" ) Castellano
        span.layout_separator= ' '
        a.link( href="/ru/" hreflang="ru" rel="alternate" ) Русский

    script( src="../index.js" )
